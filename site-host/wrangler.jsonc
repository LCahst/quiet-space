{
  // Serves the Quiet Space website on quietspace.fun (Cloudflare Workers static assets).
  // The GitHub Action builds the site into ../_site and deploys it from this folder with: npx wrangler deploy
  "name": "quietspace-site",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../_site",
    "binding": "ASSETS",
    // Run the script first so www.quietspace.fun can be sent to quietspace.fun
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "quietspace.fun", "custom_domain": true },
    { "pattern": "www.quietspace.fun", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": { "enabled": true }
}
